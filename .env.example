# Flash.Ink Environment Configuration Example
# Copy this file to .env and fill in your Stripe test keys.

# Stripe Publishable Key (starts with pk_test_...)
# Used by Flutter to initialize the native Stripe PaymentSheet SDK.
# Note: Your Stripe Secret Key (sk_test_...) should NEVER be placed in .env.
# Store it in Firebase Secret Manager via: npx firebase-tools functions:secrets:set STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: Apple Pay Merchant Identifier
STRIPE_MERCHANT_IDENTIFIER=merchant.com.seejaye.flash_ink

# Optional: Local or Deployed Backend URL (e.g. http://localhost:4242 or http://10.0.2.2:4242 for Android emulator)
STRIPE_BACKEND_URL=http://localhost:4242

# Google Maps & Places API Key
GOOGLE_PLACES_API_KEY=your_google_maps_and_places_api_key_here
