rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model (Phase 1 Backend Lockdown)
    // ===============================================================
    //
    // Collection: users/{userId}
    //   - Owner-only read/write/delete.
    //   - Immutable fields on update: ['uid', 'createdAt']
    //   - Role self-escalation blocked: role can only be 'client' if provided/modified by client.
    //
    // Collection: artists/{artistId}
    //   - Public read (marketplace discovery + embedded flashArtworks).
    //   - Owner-only create/update/delete.
    //   - Immutable fields on update: ['id', 'createdAt', 'stripeAccountId', 'isVerified']
    //   - Subcollection: private/{docId} -> owner-only read; write/delete restricted to docId == 'settings'.
    //
    // Collection: artist_schedules/{artistId}
    //   - Public read; owner-only create/update/delete with artistId == artistId check.
    //
    // Collection: bookings/{bookingId}
    //   - Read/Update restricted to booking clientId or artistId.
    //   - Create restricted to authenticated client (clientId == request.auth.uid, artistId != request.auth.uid, status == 'pending').
    //   - Immutable fields on update: ['clientId', 'artistId', 'createdAt', 'depositAmount', 'stripePaymentIntentId', 'depositPaidAt']
    //   - Subcollection: private_location/{docId} -> artist read/write; client read only when status in ['deposit_confirmed', 'confirmed', 'completed'].
    //
    // Collection: appointments/{appointmentId}
    //   - Read/Create/Update restricted to clientId or artistId; immutable ['clientId', 'artistId', 'createdAt']; delete denied.
    //
    // Collection: custom_requests/{requestId}
    //   - Read/Update restricted to clientId or artistId; create restricted to clientId == request.auth.uid; immutable ['clientId', 'artistId', 'createdAt']; delete denied.
    //
    // Collection: chats/{threadId}
    //   - Read/Update restricted to participants; create requires 2 participants including caller; immutable ['participants', 'clientId', 'artistId', 'bookingId', 'createdAt'].
    //   - Subcollection: messages/{messageId} -> read/create restricted to parent chat participants (senderId == request.auth.uid on create); update/delete denied.
    //
    // Collection: notifications/{notificationId}
    //   - Read/Update/Delete restricted to recipientId == request.auth.uid; create requires senderId == request.auth.uid.
    //   - Immutable fields on update: ['recipientId', 'senderId', 'createdAt', 'message', 'type']
    //
    // Collection: support_escalations/{ticketId}
    //   - Create-only (status == 'open', optional uid must match request.auth.uid if present); read/update/delete denied.
    //
    // Collection: auth_recovery_otps/{email}
    //   - Strictly Admin SDK only (read/write denied to all clients).
    //
    // Collection: core_config/{configId}
    //   - Authenticated read-only; client writes denied.
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocSizeValid() {
      return request.resource.data.keys().size() <= 50;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Users Collection (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isDocSizeValid()
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'client');
      allow update: if isOwner(userId)
        && isDocSizeValid()
        && areImmutableFieldsUnchanged(['uid', 'createdAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == 'client');
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // Artists Collection (/artists/{artistId}) & Private Subcollection
    // ===============================================================
    match /artists/{artistId} {
      allow read: if true;
      allow create: if isOwner(artistId)
        && isDocSizeValid()
        && (!('id' in request.resource.data) || request.resource.data.id == artistId);
      allow update: if isOwner(artistId)
        && isDocSizeValid()
        && areImmutableFieldsUnchanged(['id', 'createdAt', 'stripeAccountId', 'isVerified']);
      allow delete: if isOwner(artistId);

      match /private/{docId} {
        allow read: if isOwner(artistId);
        allow create, update: if isOwner(artistId) && docId == 'settings' && isDocSizeValid();
        allow delete: if isOwner(artistId) && docId == 'settings';
      }
    }

    // ===============================================================
    // Artist Schedules Collection (/artist_schedules/{artistId})
    // ===============================================================
    match /artist_schedules/{artistId} {
      allow read: if true;
      allow create, update: if isOwner(artistId)
        && isDocSizeValid()
        && request.resource.data.artistId == artistId;
      allow delete: if isOwner(artistId);
    }

    // ===============================================================
    // Bookings Collection (/bookings/{bookingId}) & Private Location
    // ===============================================================
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid);
      allow create: if isSignedIn()
        && isDocSizeValid()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.artistId is string
        && request.resource.data.artistId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && isDocSizeValid()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid)
        && areImmutableFieldsUnchanged(['clientId', 'artistId', 'createdAt', 'depositAmount', 'stripePaymentIntentId', 'depositPaidAt']);
      allow delete: if false;

      match /private_location/{docId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.artistId == request.auth.uid
          || (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid
            && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status in ['deposit_confirmed', 'confirmed', 'completed']
          )
        );
        allow write: if isSignedIn()
          && get(/databases/$(database)/documents/bookings/$(bookingId)).data.artistId == request.auth.uid;
      }
    }

    // ===============================================================
    // Appointments Collection (/appointments/{appointmentId})
    // ===============================================================
    match /appointments/{appointmentId} {
      allow read: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid);
      allow create: if isSignedIn()
        && isDocSizeValid()
        && (request.resource.data.clientId == request.auth.uid || request.resource.data.artistId == request.auth.uid);
      allow update: if isSignedIn()
        && isDocSizeValid()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid)
        && areImmutableFieldsUnchanged(['clientId', 'artistId', 'createdAt']);
      allow delete: if false;
    }

    // ===============================================================
    // Custom Requests Collection (/custom_requests/{requestId})
    // ===============================================================
    match /custom_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid);
      allow create: if isSignedIn()
        && isDocSizeValid()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.artistId is string;
      allow update: if isSignedIn()
        && isDocSizeValid()
        && (resource.data.clientId == request.auth.uid || resource.data.artistId == request.auth.uid)
        && areImmutableFieldsUnchanged(['clientId', 'artistId', 'createdAt']);
      allow delete: if false;
    }

    // ===============================================================
    // Chats Collection (/chats/{threadId}) & Messages Subcollection
    // ===============================================================
    match /chats/{threadId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && isDocSizeValid()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
        && isDocSizeValid()
        && request.auth.uid in resource.data.participants
        && areImmutableFieldsUnchanged(['participants', 'clientId', 'artistId', 'bookingId', 'createdAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participants;
        allow create: if isSignedIn()
          && isDocSizeValid()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(threadId)).data.participants
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Notifications Collection (/notifications/{notificationId})
    // ===============================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && isDocSizeValid()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && areImmutableFieldsUnchanged(['recipientId', 'senderId', 'createdAt', 'message', 'type']);
      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // ===============================================================
    // Support Escalations Collection (/support_escalations/{ticketId})
    // ===============================================================
    match /support_escalations/{ticketId} {
      allow create: if isDocSizeValid()
        && request.resource.data.status == 'open'
        && (!('uid' in request.resource.data) || (isSignedIn() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }

    // ===============================================================
    // Auth Recovery OTPs Collection (/auth_recovery_otps/{email})
    // ===============================================================
    match /auth_recovery_otps/{email} {
      allow read, write: if false;
    }

    // ===============================================================
    // Core Config Collection (/core_config/{configId})
    // ===============================================================
    match /core_config/{configId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ===============================================================
    // Default Deny All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
