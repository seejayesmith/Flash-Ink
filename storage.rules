rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /user_profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /artist_profiles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /flash_artworks/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
