# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will automatically add this to its gitignore in its first run
# but you can include it here to be safe
/android/app/debug
/android/app/profile
/android/app/release

# Xcode / macOS / iOS
**/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcuserdatad
# Agents internal artifacts
.agents/
